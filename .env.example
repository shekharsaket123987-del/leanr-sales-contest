# Copy to .env.local and fill in. NEVER commit your real .env.local.

# ---- Google service account (Sheets API, read-only) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Contest spreadsheet ID (the long id between /d/ and /edit in the sheet URL) ----
SHEET_CONTEST_ID=
